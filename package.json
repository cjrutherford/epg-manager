{
  "name": "epg-manager",
  "version": "0.1.0",
  "description": "IPTV Playlist and EPG Manager with automatic channel matching and metadata enrichment",
  "main": "dist/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjrutherford/epg-manager.git"
  },
  "author": "cjrutherford",
  "keywords": [
    "iptv",
    "epg",
    "xmltv",
    "m3u",
    "tvmaze",
    "jellyfin",
    "plex",
    "playlist"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "build:client": "cd client && npx ng build",
    "build:mobile": "cd client && npx ng build --configuration mobile && npx cap sync && cd android && JAVA_HOME=/home/cjrutherford/workspace/epg-manager/client/jdk-21 ./gradlew assembleDebug",
    "build:all": "tsc && cd client && npx ng build",
    "dev": "ts-node src/server.ts",
    "dev:client": "cd client && npx ng serve --proxy-config proxy.conf.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:start": "docker compose up -d --build"
  },
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.9.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.6.2",
    "cli-progress": "^3.12.0",
    "dayjs": "^1.11.20",
    "epg-grabber": "^0.47.0",
    "express": "^4.18.2",
    "fuse.js": "^7.0.0",
    "iptv-playlist-parser": "^0.13.0",
    "lodash.merge": "^4.6.2",
    "node-cron": "^4.2.1",
    "sax": "^1.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/adm-zip": "^0.5.8",
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/sax": "^1.2.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
